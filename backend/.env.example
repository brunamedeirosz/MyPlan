DJANGO_DEBUG=true
# Chave exclusiva para desenvolvimento; defina uma chave aleatoria antes de publicar.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_ENGINE=sqlite
